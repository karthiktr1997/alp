              "html": "<div class=\"center\"><span class=\"eyebrow\">What We Offer</span><h2 style=\"margin-top:16px;font-family:Poppins,sans-serif;font-weight:700;\">Our Services</h2><p class=\"lead\" style=\"max-width:54ch;margin:16px auto 0;\">Comprehensive Vedic astrology services tailored to guide every aspect of your life journey.</p></div>"
            }
