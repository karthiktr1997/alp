          {
            "id": "f6a7b8cc",
            "elType": "widget",
            "widgetType": "html",
            "settings": {
              "html": "<div class=\"card-grid c4\" style=\"margin-top:40px;\"><article class=\"s-card\"><div class=\"s-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"/><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"/></svg></div><h3>Consultation</h3><p>One-on-one personalised readings covering career, relationships, health, and all major life areas.</p><a href=\"/consultation\" class=\"btn btn-outline\" style=\"margin-top:20px;font-size:.88rem;padding:.65em 1.2em;\">Learn More</a></article><article class=\"s-card\"><div class=\"s-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z\"/><path d=\"M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z\"/></svg></div><h3>Courses</h3><p>Structured Vedic astrology courses from foundations to advanced predictive techniques and KP system.</p><a href=\"/courses\" class=\"btn btn-outline\" style=\"margin-top:20px;font-size:.88rem;padding:.65em 1.2em;\">Learn More</a></article><article class=\"s-card\"><div class=\"s-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"3\" width=\"20\" height=\"14\" rx=\"2\" ry=\"2\"/><line x1=\"8\" y1=\"21\" x2=\"16\" y2=\"21\"/><line x1=\"12\" y1=\"17\" x2=\"12\" y2=\"21\"/></svg></div><h3>Astrology Software</h3><p>Professional Vedic astrology software for chart generation, transit analysis, and predictive calculations.</p><a href=\"/services\" class=\"btn btn-outline\" style=\"margin-top:20px;font-size:.88rem;padding:.65em 1.2em;\">Learn More</a></article><article class=\"s-card\"><div class=\"s-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20\"/><path d=\"M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z\"/></svg></div><h3>Books &amp; Resources</h3><p>Curated astrology books, reference guides, and digital resources for students and practitioners.</p><a href=\"/services\" class=\"btn btn-outline\" style=\"margin-top:20px;font-size:.88rem;padding:.65em 1.2em;\">Learn More</a></article></div>"
